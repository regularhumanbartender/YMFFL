{
  "name": "ymffl-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "dev:remote": "vite --mode code-workspaces",
    "format": "prettier --write src/",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --report-unused-disable-directives --max-warnings 0 --fix",
    "postinstall": "osdk branch sync",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:publisher": "tsc --noEmit --module esnext --moduleResolution bundler --target es2022 --skipLibCheck --strict scripts/export-snapshot.ts scripts/create-demo.ts",
    "snapshot:export": "tsx scripts/export-snapshot.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@blueprintjs/core": "^6.10.0",
    "@blueprintjs/icons": "^6.7.0",
    "@osdk/aliases": "^0.4.0",
    "@osdk/client": "^2.77.0",
    "@osdk/foundry": "^2.75.0",
    "@osdk/oauth": "^1.1.0",
    "@osdk/react": "^2.87.0",
    "@osdk/vite-plugin-branch": "^2.77.0",
    "@tanstack/react-query": "^5.108.4",
    "@ymffl-website/sdk": "0.1.0",
    "normalize.css": "^8.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^6.30.1",
    "tsx": "^4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.35.0",
    "@osdk/cli": "0.115.0",
    "@playwright/test": "^1.65.1",
    "@trivago/prettier-plugin-sort-imports": "^5.0.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/node": "^24.10.13",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.35.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.0.0",
    "typescript": "~5.5.4",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.3.1",
    "vitest": "5.1.1"
  }
}
